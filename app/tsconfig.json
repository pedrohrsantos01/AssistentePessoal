{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "jest"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "harness/**/*.ts",
    "app.config.ts",
    "src/**/*.tsx",
    "test/**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
