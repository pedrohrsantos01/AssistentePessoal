{
  "name": "ritmo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test test/integration/*.test.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "expo": "57.0.25",
    "expo-crypto": "57.0.3",
    "expo-network": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "better-sqlite3": "12.4.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.9.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "main": "harness/index.ts"
}
