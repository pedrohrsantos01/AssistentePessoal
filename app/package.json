{
  "name": "ritmo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:domain && pnpm test:components",
    "test:e2e": "node --import tsx --test test/integration/*.test.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "test:components": "jest --runInBand",
    "test:domain": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/chakra-petch": "0.4.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@noble/hashes": "2.4.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-network": "57.0.2",
    "expo-router": "57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@testing-library/react-native": "14.1.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "babel-preset-expo": "57.0.13",
    "better-sqlite3": "12.4.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.9.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.2.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "main": "index.js"
}
