# Runtime only. Empty mandatory values must be supplied through the private secret channel.
# Never use build arguments for credentials or commit a populated environment file.
RITMO_DB_URL=
RITMO_DB_USER=
RITMO_DB_PASSWORD=
RITMO_MIGRATION_USER=
RITMO_MIGRATION_PASSWORD=
RITMO_IDENTITY_USER=
RITMO_IDENTITY_PASSWORD=
RITMO_SIGNING_KEY=

# Both remain enabled during installation/recovery; remove quarantine only after external gates.
RITMO_REQUIRE_WAL=true
RITMO_RECOVERY_QUARANTINE=true
RITMO_WAL_WAIT_MS=2000
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Verified HTTPS origin and Resend sender/domain are still pending external acceptance.
RITMO_PUBLIC_ORIGIN=
RITMO_MAIL_FROM=
RITMO_SMTP_HOST=smtp.resend.com
RITMO_SMTP_PORT=2587
RITMO_SMTP_USER=resend
RITMO_SMTP_PASSWORD=
RITMO_SMTP_AUTH=true

# Proxy trust is deliberately unset until its private address boundary is verified.
SERVER_FORWARD_HEADERS_STRATEGY=none
# Exact literal private peers only; empty means trust nobody. See ops/proxy-tls.md.
RITMO_TRUSTED_PROXY_PEERS=
